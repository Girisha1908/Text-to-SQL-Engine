# Copy to .env for local runs. Never commit .env.

# Local Postgres from docker-compose.yml. On Vercel, set this to your Neon connection string.
DATABASE_URL=postgresql+psycopg://askdata:askdata@localhost:5433/askdata

ASK_DB_SCHEMA=ask_demo
# "Today" for relative dates like "last month". The demo data is built around 2026-10-13.
ASK_AS_OF_DATE=2026-10-13

# offline (default, free, no network) | groq | gemini
ASK_LLM_PROVIDER=offline
# ASK_LLM_MODEL=
# GROQ_API_KEY=
# GEMINI_API_KEY=
